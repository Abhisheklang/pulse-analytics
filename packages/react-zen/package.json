{
  "author": "Pulselytics",
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@react-spring/web": "^9.7.5",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.555.0",
    "react-day-picker": "^9.11.1",
    "react-hook-form": "^7.66.1",
    "react-resizable-panels": "^4.12.2",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "zustand": "^5.0.8"
  },
  "description": "React UI component library for Pulse Analytics. Vendored in-tree copy of the MIT-licensed react-zen component library, maintained as a workspace package.",
  "devDependencies": {
    "@tailwindcss/cli": "4.1.18",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "^22.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "glob": "^13.0.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.29",
    "tailwindcss": "4.1.18",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./styles.css",
    "./styles.full.css": "./styles.full.css",
    "./tailwind-preset": "./tailwind.preset.ts"
  },
  "files": [
    "dist",
    "styles.css",
    "styles.full.css",
    "tailwind.preset.ts"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "name": "@pulselytics/react-zen",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "private": true,
  "scripts": {
    "build": "npm-run-all tsup css",
    "css": "node css.mjs",
    "dev": "npm-run-all --parallel dev:tsup dev:css",
    "dev:css": "node css.mjs --watch",
    "dev:tsup": "tsup --watch",
    "tsup": "tsup"
  },
  "sideEffects": [
    "*.css"
  ],
  "types": "dist/index.d.ts",
  "version": "0.255.0"
}
