{
  "name": "@pulselytics/api-client",
  "version": "0.82.0",
  "description": "API client for Pulse Analytics (self-hosted web analytics)",
  "author": "Pulselytics",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "pulse",
    "analytics",
    "api",
    "client",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  }
}
