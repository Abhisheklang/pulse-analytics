{
  "name": "@pulselytics/mcp",
  "version": "0.2.1",
  "description": "MCP server for Pulse Analytics",
  "author": "Pulselytics",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pulse-mcp": "./bin/pulse-mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm --filter @pulselytics/api-client build && pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "@pulselytics/api-client": "workspace:*",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.4.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "pulse",
    "analytics",
    "mcp",
    "model-context-protocol"
  ]
}
