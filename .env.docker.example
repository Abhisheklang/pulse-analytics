# Example environment for the Docker Compose setup.
# Copy this file to .env and change every value marked below:
#
#   cp .env.docker.example .env
#
# The .env file itself must never be committed to git.

# PostgreSQL settings for the db service in docker-compose.yml.
POSTGRES_USER=pulse
POSTGRES_DB=pulse
# CHANGE-ME: set a real password here.
POSTGRES_PASSWORD=pulse

# Connection string the app uses to reach the database.
# The host "db" is the Compose service name. If you change
# POSTGRES_PASSWORD above, change the password in this URL to match.
DATABASE_URL=postgresql://pulse:pulse@db:5432/pulse

# Used by the app to generate unique values for this installation.
# CHANGE-ME: generate a real secret, for example with:
#   openssl rand -hex 32
APP_SECRET=change-me-generate-a-real-secret
